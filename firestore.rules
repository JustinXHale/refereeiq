rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Backend-only caches (Admin SDK / Cloud Functions) ---
    match /incident_cache/{cacheId} {
      allow read, write: if false;
    }

    match /sofia_chat_cache/{docId} {
      allow read, write: if false;
    }

    match /question_bank/{questionId} {
      allow read, write: if false;
    }

    // Query history — written only by Cloud Functions; clients read/delete own rows
    match /query_history/{queryId} {
      // Users can only read their own query history
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.uid;

      // Users can delete their own query history
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.uid;

      // Only Cloud Functions can write (via admin SDK)
      allow write: if false;
    }

    // Users collection
    match /users/{userId} {
      // Users can read and write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard collection
    match /leaderboard/{userId} {
      // Anyone can read leaderboard entries
      allow read: if request.auth != null;
      // Only authenticated users can write their own entries (via Firestore service)
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Daily challenges collection
    match /daily_challenges/{challengeId} {
      // Anyone can read challenges
      allow read: if request.auth != null;
      // Only Cloud Functions can write
      allow write: if false;
    }

    // Challenge attempts collection
    match /challenge_attempts/{attemptId} {
      // Users can read their own attempts
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      // Users can create their own attempts
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      // No updates or deletes
      allow update, delete: if false;
    }

    // App config collection (read-only for clients)
    match /app_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Laws collection (read-only for clients)
    match /laws/{version}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
